{
  # Hand-written. Inputs live in `flake-file.inputs.*` across modules/ and are
  # rendered to .tack/pins.toml by `nix run .#write-lock` (see AGENTS.md).
  outputs = {self, ...} @ args:
    import ./outputs.nix {
      tackOverrides = args.tackOverrides or {};
      flakeSelf = self;
    };

  nixConfig = {
    extra-substituters = [
      "https://nix-community.cachix.org"
      "https://opinionatedcache.cachix.org"
      "https://cache.flox.dev"
      "https://cache.nixos-cuda.org"
      "https://nixos-raspberrypi.cachix.org"
      "https://cache.lantian.pub/lantian"
      "https://cache.manic.systems"
    ];
